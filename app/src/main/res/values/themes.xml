<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme, will be set dynamically. Default is Light. -->
    <style name="Theme.DoodleCraft" parent="Theme.DoodleCraft.Light" />

    <!-- Light Theme -->
    <style name="Theme.DoodleCraft.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.DoodleCraft.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Night (Dimmed) Theme -->
    <style name="Theme.DoodleCraft.Night" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/night_background</item>
        <item name="colorSurface">@color/night_surface</item>
        <item name="colorPrimary">@color/night_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorOnSurface">@color/night_on_surface</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/night_surface</item>
    </style>

    <style name="Widget.App.ImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:padding">12dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

</resources>
